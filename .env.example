# --- Vercel env vars (Preview environment first, never commit real values) ---

# Google AI Studio (ai.google.dev) — server-side only, never exposed to the frontend
GEMINI_API_KEY=

# Neon connection string for the kb_api role (select-only on kb_chunks)
NEON_DATABASE_URL=

# Upstash Redis (REST API, not raw redis:// protocol)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Local-only, used by scripts/ingest.js, NEVER added to Vercel ---

# Neon connection string for the kb_ingest role (full CRUD on kb_chunks)
NEON_INGEST_DATABASE_URL=
